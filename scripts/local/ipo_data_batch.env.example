# Copy to scripts/local/ipo_data_batch.env and fill values.
# Do not commit the copied .env file.

FINUTS_ID=
FINUTS_PASSWORD=

# Optional. Defaults to dart from PATH.
# DART_BIN=/opt/homebrew/bin/dart

# Optional. Defaults to python3 from PATH.
# PYTHON_BIN=/opt/homebrew/bin/python3

# Optional. Pull before each local batch.
IPO_DATA_GIT_PULL=1

# Optional. Commit generated changes after each batch.
IPO_DATA_GIT_COMMIT=1

# Optional. Push generated commits after each batch.
IPO_DATA_GIT_PUSH=1

# Optional. Commit author for generated data commits.
IPO_DATA_GIT_USER_NAME=ipo-competition-local-bot
IPO_DATA_GIT_USER_EMAIL=ipo-competition-local-bot@users.noreply.github.com

# Optional. Live scheduler window in KST.
IPO_DATA_LIVE_START=09:00
IPO_DATA_LIVE_END=17:30

# Optional. Defaults to Naver-only live competition updates.
# Set to live only when FINUTS_ID/FINUTS_PASSWORD should be used.
IPO_DATA_LIVE_BATCH=naver-live

# Optional. public-refresh avoids Finuts and uses configured public sources
# such as DART/iTick/IPOKorea/articles/Naver.
IPO_DATA_BASELINE_BATCH=public-refresh

# Optional. Demand still requires Finuts, so it is off by default.
IPO_DATA_DEMAND_ENABLED=0
IPO_DATA_BASELINE_ENABLED=1
